{
  "name": "my-todo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env NODE_ENV=test vitest run",
    "db:migration:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language cjs --migration-filename-format index",
    "db:migrate": "yarn db:migrate:production",
    "db:migrate:production": "cross-env NODE_ENV=production node-pg-migrate up --database-url-var DATABASE_URL --migrations-dir migrations --migrations-table schema_migrations --schema public --single-transaction --advisory-lock-mode fail",
    "db:migrate:test": "cross-env NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node -r dotenv/config scripts/setup-test-db.js",
    "test:setup": "yarn db:migrate:test",
    "test:cleanup": "cross-env NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node -r dotenv/config scripts/cleanup-test-db.js",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:db": "cross-env NODE_ENV=test DOTENV_CONFIG_PATH=.env.test node -r dotenv/config node_modules/vitest/vitest.mjs run --config vite.db.config.js",
    "test:full": "yarn test:coverage && yarn test:db",
    "db:verify:production": "cross-env NODE_ENV=production node scripts/verify-production-db.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.8.2",
    "@clerk/nextjs": "^7.5.7",
    "@vercel/functions": "^3.9.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.562.0",
    "next": "^16.2.11",
    "pg": "^8.14.1",
    "react": "^19.2.7",
    "react-datepicker": "^8.10.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.4",
    "cross-env": "^7.0.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "jsdom": "^26.1.0",
    "node-mocks-http": "^1.17.2",
    "node-pg-migrate": "^9.0.0",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "8.0.16",
    "vitest": "^4.1.9"
  },
  "resolutions": {
    "tailwindcss/sucrase/glob": "10.5.0",
    "ajv": "^6.12.6",
    "rollup": ">=4.59.0",
    "flatted": "^3.4.0",
    "ws": "8.21.0",
    "vite": "8.0.16",
    "js-yaml": "4.3.1",
    "**/postcss": "8.5.25",
    "**/nanoid": "3.3.18",
    "@babel/core": "7.29.6"
  }
}
